rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "dennisbottari@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidPerson(data) {
      return data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100 &&
             data.gender in ['male', 'female', 'other'] &&
             (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20)) &&
             (!('deathDate' in data) || (data.deathDate is string && data.deathDate.size() <= 20)) &&
             (!('fatherId' in data) || (data.fatherId is string && data.fatherId.size() <= 128)) &&
             (!('motherId' in data) || (data.motherId is string && data.motherId.size() <= 128)) &&
             (!('spouseIds' in data) || data.spouseIds is list) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    match /people/{personId} {
      // Broad read access for the genealogy tree
      allow read: if true;
      
      // Admin only write access with validation
      allow create: if isAdmin() && isValidPerson(request.resource.data);
      allow update: if isAdmin() && isValidPerson(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
