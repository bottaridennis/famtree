rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Tenere allineato con ADMIN_EMAILS in src/config.ts
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "dennisbottari@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function optString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function isValidPerson(data) {
      return data.keys().hasOnly([
               'firstName', 'lastName', 'nickname', 'gender',
               'birthDate', 'birthPlace', 'deathDate', 'deathPlace', 'deceased',
               'occupation', 'fatherId', 'motherId', 'spouseIds', 'bio', 'photoUrl'
             ]) &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100 &&
             data.gender in ['male', 'female', 'other'] &&
             optString(data, 'nickname', 100) &&
             optString(data, 'birthDate', 20) &&
             optString(data, 'birthPlace', 200) &&
             optString(data, 'deathDate', 20) &&
             optString(data, 'deathPlace', 200) &&
             optString(data, 'occupation', 200) &&
             optString(data, 'fatherId', 128) &&
             optString(data, 'motherId', 128) &&
             optString(data, 'bio', 2000) &&
             optString(data, 'photoUrl', 500) &&
             (!('deceased' in data) || data.deceased is bool) &&
             (!('spouseIds' in data) || (data.spouseIds is list && data.spouseIds.size() <= 20));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /people/{personId} {
      // Lettura pubblica dell'albero
      allow read: if true;

      // Scrittura solo per l'amministratore, con validazione dello schema
      allow create, update: if isAdmin() && isValidPerson(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
